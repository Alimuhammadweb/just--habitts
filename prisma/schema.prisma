model Habit {
  id                 BigInt   @id
  userId             BigInt
  position           Int      @default(0)
  name               String
  duration           Int
  timeHour           Int?
  timeMinute         Int?
  notifications      Boolean  @default(false)
  startDay           Int
  startMonth         Int
  startYear          Int
  startTimestamp     BigInt
  scheduledStartTime BigInt?
  why                String   @default("")

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  days               HabitDay[]

  @@index([userId, position])
}

model HabitDay {
  habitId     BigInt
  dayIndex    Int
  status      String?   // completed | partial | missed | frozen
  lockStatus  String?
  markedAt    BigInt?
  dateString  String?
  xpAwarded   Int?
  locked      Boolean?
  missReason  String?

  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, dayIndex])
}

model XpHistory {
  id         Int    @id @default(autoincrement())
  userId     BigInt
  date       String
  xpEarned   Int
  habitId    BigInt
  dayIndex   Int
  status     String
  timestamp  BigInt

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
}

model PomodoroSession {
  pk         Int    @id @default(autoincrement())
  userId     BigInt
  sessionId  BigInt
  date       String
  count      Int

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model ActiveChallenge {
  pk            Int      @id @default(autoincrement())
  userId        BigInt
  challengeId   Int
  startedAt     BigInt
  completedDays Int[]    @default([])
  isCompleted   Boolean  @default(false)
  completedAt   BigInt?
  startDateKey  String?
  endDateKey    String?
  attempt       Int?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Do'stlik ikki tomonlama saqlanadi: (A,B) va (B,A)
model Friendship {
  userId    BigInt
  friendId  BigInt

  user      User   @relation("FriendOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend    User   @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
}

model FriendRequest {
  fromId  BigInt
  toId    BigInt

  from    User   @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to      User   @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
}

model WeeklyTask {
  id           String    @id @default(cuid())
  userId       BigInt
  title        String
  description  String    @default("")
  date         String    // YYYY-MM-DD
  time         String?   // HH:MM
  durationMin  Int?
  category     String
  priority     String
  reminderMin  Int?
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, time])
  @@index([userId, completed, date])
}

